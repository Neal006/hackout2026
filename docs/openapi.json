 "components": {
  "schemas": {
   "AssistAction": {
    "properties": {
     "label": {
      "type": "string",
      "title": "Label"
     },
     "path": {
      "type": "string",
      "title": "Path"
     }
    },
    "type": "object",
    "required": [
     "label",
     "path"
    ],
    "title": "AssistAction"
   },
   "AssistIn": {
    "properties": {
     "question": {
      "type": "string",
      "maxLength": 2000,
      "minLength": 1,
      "title": "Question"
     },
     "history": {
      "items": {
       "$ref": "#/components/schemas/Turn"
      },
      "type": "array",
      "title": "History",
      "default": []
     },
     "page": {
      "type": "string",
      "maxLength": 200,
      "title": "Page",
      "default": ""
     }
    },
    "type": "object",
    "required": [
     "question"
    ],
    "title": "AssistIn"
   },
   "AssistOut": {
    "properties": {
     "answer": {
      "type": "string",
      "title": "Answer"
     },
     "sources": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Sources",
      "default": []
     },
     "suggested_actions": {
      "items": {
       "$ref": "#/components/schemas/AssistAction"
      },
      "type": "array",
      "title": "Suggested Actions",
      "default": []
     },
     "fallback": {
      "type": "boolean",
      "title": "Fallback",
      "default": false
     },
     "degraded": {
      "type": "boolean",
      "title": "Degraded",
      "default": false
     },
     "usage": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "title": "Usage"
     }
    },
    "type": "object",
    "required": [
     "answer"
    ],
    "title": "AssistOut"
   },
   "ConnectorPlan": {
    "properties": {
     "connector_id": {
      "type": "string",
      "title": "Connector Id"
     },
     "session_id": {
      "type": "integer",
      "title": "Session Id"
     },
     "kw": {
      "items": {
       "type": "number"
      },
      "type": "array",
      "title": "Kw"
     }
    },
    "type": "object",
    "required": [
     "connector_id",
     "session_id",
     "kw"
    ],
    "title": "ConnectorPlan"
   },
   "DemoOut": {
    "properties": {
     "changed": {
      "type": "string",
      "title": "Changed"
     },
     "detail": {
      "additionalProperties": true,
      "type": "object",
      "title": "Detail"
     }
    },
    "type": "object",
    "required": [
     "changed",
     "detail"
    ],
    "title": "DemoOut"
   },
   "DrEvent": {
    "properties": {
     "start": {
      "type": "string",
      "format": "date-time",
      "title": "Start"
     },
     "end": {
      "type": "string",
      "format": "date-time",
