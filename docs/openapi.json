  "/sessions/{sid}/urgency": {
   "post": {
    "summary": "Urgency",
    "description": "business.md \u00a74b. now: deadline = now, full power (the ASAP path). soon: deadline = leave_at, the LP picks the\ncleanest slots inside the window (< 15 min away = now). priority: deadline unchanged, floor 90 % pro-rata and the\nshortfall weight doubled. Every band marks the session urgent, so price() returns exactly R.",
    "operationId": "urgency_sessions__sid__urgency_post",
    "parameters": [
     {
      "name": "sid",
      "in": "path",
      "required": true,
      "schema": {
       "type": "integer",
       "title": "Sid"
      }
