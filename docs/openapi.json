  "/price": {
   "get": {
    "summary": "Price Preview",
    "description": "What a ready-by would cost before plugging in. No session yet, so the discount is today's site saving rate so far\n(sum of measured session savings over delivered kWh) applied to this need: an estimate, settled on the receipt.",
    "operationId": "price_preview_price_get",
    "parameters": [
     {
      "name": "departure_at",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "format": "date-time",
       "title": "Departure At"
      }
     },
     {
      "name": "kwh_needed",
      "in": "query",
      "required": false,
      "schema": {
       "type": "number",
       "default": 8.0,
